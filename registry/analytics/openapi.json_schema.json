{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise.io/schemas/analytics.json",
  "title": "Analytics Data Contract",
  "type": "object",
  "description": "Hierarchical data contract for dataset analytics",
  "$ref": "#/$defs/assets",
  "$defs": {
    "assets": {
      "type": "object",
      "title": "Assets",
      "description": "DOCUMENT entity mapped from XML tag <ASSETS>",
      "properties": {
        "assets_pk": {
          "type": "string",
          "description": "Surrogate primary key for entity assets"
        },
        "asof_date": {
          "type": "string",
          "description": "XPath: /ASSETS/@ASOF_DATE"
        },
        "create_date": {
          "type": "string",
          "description": "XPath: /ASSETS/@CREATE_DATE"
        },
        "records": {
          "type": "integer",
          "description": "XPath: /ASSETS/@RECORDS"
        },
        "esg_rating": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/ESG_RATING"
        },
        "rating_agency": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/RATING_AGENCY"
        }
      },
      "required": [
        "assets_pk",
        "asof_date",
        "create_date",
        "records"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "title": "Asset",
      "description": "RECORD entity mapped from XML tag <ASSET>",
      "properties": {
        "asset_pk": {
          "type": "string",
          "description": "Surrogate primary key for entity asset"
        },
        "assets_fk": {
          "type": "string",
          "description": "Foreign key referencing assets.assets_pk"
        },
        "class_val": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/CLASS"
        },
        "accrual_dt": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/ACCRUAL_DT"
        },
        "amt_isu": {
          "type": "integer",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/AMT_ISU"
        },
        "announce_dt": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/ANNOUNCE_DT"
        },
        "calc_type": {
          "type": "integer",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/CALC_TYPE"
        },
        "call_mandatory": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/CALL_MANDATORY"
        },
        "call_type": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/CALL_TYPE"
        },
        "cd_instmt_type": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/CD_INSTMT_TYPE"
        },
        "change_dt": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/CHANGE_DT"
        },
        "compound_flag": {
          "type": "integer",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/COMPOUND_FLAG"
        },
        "country": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/COUNTRY"
        },
        "coupon_fix": {
          "type": "number",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/COUPON_FIX"
        },
        "coup_freq": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/COUP_FREQ"
        },
        "cpn_type": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/CPN_TYPE"
        },
        "currency": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/CURRENCY"
        },
        "cusip": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/CUSIP"
        },
        "cusip_type": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/CUSIP_TYPE"
        },
        "date_conv": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/DATE_CONV"
        },
        "desc_instmt": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/DESC_INSTMT"
        },
        "end_adj_flag": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/END_ADJ_FLAG"
        },
        "first_pay_dt": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/FIRST_PAY_DT"
        },
        "first_settle_dt": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/FIRST_SETTLE_DT"
        },
        "flag_144_a": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/FLAG_144A"
        },
        "flag_reg_s": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/FLAG_REG_S"
        },
        "issue_price": {
          "type": "number",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/ISSUE_PRICE"
        },
        "maturity_dt": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/MATURITY_DT"
        }
      },
      "required": [
        "asset_pk",
        "assets_fk",
        "class_val",
        "accrual_dt",
        "amt_isu",
        "announce_dt",
        "calc_type",
        "call_mandatory",
        "call_type",
        "cd_instmt_type",
        "change_dt",
        "compound_flag",
        "country",
        "coupon_fix",
        "coup_freq",
        "cpn_type",
        "currency",
        "cusip",
        "cusip_type",
        "date_conv",
        "desc_instmt",
        "end_adj_flag",
        "first_pay_dt",
        "first_settle_dt",
        "flag_144_a",
        "flag_reg_s",
        "issue_price",
        "maturity_dt"
      ],
      "additionalProperties": false
    },
    "country_classification": {
      "type": "object",
      "title": "Country_Classification",
      "description": "CHILD entity mapped from XML tag <COUNTRY_CLASSIFICATION_record>",
      "properties": {
        "country_classification_pk": {
          "type": "string",
          "description": "Surrogate primary key for entity country_classification"
        },
        "asset_fk": {
          "type": "string",
          "description": "Foreign key referencing asset.asset_pk"
        },
        "cntry": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/COUNTRY_CLASSIFICATION_set/COUNTRY_CLASSIFICATION_record/CNTRY"
        },
        "cntry_src": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/COUNTRY_CLASSIFICATION_set/COUNTRY_CLASSIFICATION_record/CNTRY_SRC"
        },
        "cntry_type": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/COUNTRY_CLASSIFICATION_set/COUNTRY_CLASSIFICATION_record/CNTRY_TYPE"
        }
      },
      "required": [
        "country_classification_pk",
        "asset_fk",
        "cntry",
        "cntry_src",
        "cntry_type"
      ],
      "additionalProperties": false
    },
    "cusip2": {
      "type": "object",
      "title": "Cusip2",
      "description": "CHILD entity mapped from XML tag <CUSIP2_record>",
      "properties": {
        "cusip2_pk": {
          "type": "string",
          "description": "Surrogate primary key for entity cusip2"
        },
        "asset_fk": {
          "type": "string",
          "description": "Foreign key referencing asset.asset_pk"
        },
        "code": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/CUSIP2_set/CUSIP2_record/CODE"
        },
        "identifier": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/CUSIP2_set/CUSIP2_record/IDENTIFIER"
        }
      },
      "required": [
        "cusip2_pk",
        "asset_fk",
        "code",
        "identifier"
      ],
      "additionalProperties": false
    },
    "cusip_alias": {
      "type": "object",
      "title": "Cusip_Alias",
      "description": "CHILD entity mapped from XML tag <CUSIP_ALIAS_record>",
      "properties": {
        "cusip_alias_pk": {
          "type": "string",
          "description": "Surrogate primary key for entity cusip_alias"
        },
        "asset_fk": {
          "type": "string",
          "description": "Foreign key referencing asset.asset_pk"
        },
        "code": {
          "type": "integer",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/CUSIP_ALIAS_set/CUSIP_ALIAS_record/CODE"
        },
        "identifier": {
          "type": "integer",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/CUSIP_ALIAS_set/CUSIP_ALIAS_record/IDENTIFIER"
        },
        "purpose": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/CUSIP_ALIAS_set/CUSIP_ALIAS_record/PURPOSE"
        }
      },
      "required": [
        "cusip_alias_pk",
        "asset_fk",
        "code",
        "identifier",
        "purpose"
      ],
      "additionalProperties": false
    },
    "rating": {
      "type": "object",
      "title": "Rating",
      "description": "CHILD entity mapped from XML tag <RATING_record>",
      "properties": {
        "rating_pk": {
          "type": "string",
          "description": "Surrogate primary key for entity rating"
        },
        "asset_fk": {
          "type": "string",
          "description": "Foreign key referencing asset.asset_pk"
        },
        "rating_agency": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/RATING_set/RATING_record/AGENCY"
        },
        "rating_rating": {
          "type": "string",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/RATING_set/RATING_record/RATING"
        },
        "rating_rating_date": {
          "type": "string",
          "format": "date",
          "description": "XPath: /ASSETS/ASSET/BND_CORP/RATING_set/RATING_record/RATING_DATE"
        }
      },
      "required": [
        "rating_pk",
        "asset_fk"
      ],
      "additionalProperties": false
    }
  }
}